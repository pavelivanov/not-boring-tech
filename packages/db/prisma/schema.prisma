generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AnalyzedPostStatus {
  PRESENTATIONS_SAVED
  NOT_RELEVANT
  SKIPPED_NO_TEXT
  RETRYABLE_FAILURE
  REVIEW_REQUIRED
}

enum PresentationKind {
  PROJECT
  TOOL
  LIBRARY
  SERVICE
  PRODUCT
  FEATURE
  PLUGIN
  SKILL
  GUIDE
  CHEAT_SHEET
  PODCAST
  OTHER_TECH
}

enum IngestionRunStatus {
  RUNNING
  SUCCEEDED
  PARTIAL
  FAILED
}

model Channel {
  id                         String         @id @default(uuid()) @db.Uuid
  handle                     String         @unique @db.VarChar(33)
  telegramPeerId             BigInt?        @unique
  title                      String?        @db.VarChar(255)
  publicUrl                  String         @db.VarChar(2048)
  enabled                    Boolean        @default(true)
  incrementalCursorMessageId BigInt?
  backfillBeforeMessageId    BigInt?
  backfillCutoffAt           DateTime?
  backfillCompletedAt        DateTime?
  lastCollectedAt            DateTime?
  createdAt                  DateTime       @default(now())
  updatedAt                  DateTime       @updatedAt
  analyzedPosts              AnalyzedPost[]

  @@index([enabled])
}

model CatalogItem {
  id               String                  @id @default(uuid()) @db.Uuid
  identityKey      String                  @unique @db.VarChar(69)
  slug             String                  @unique @db.VarChar(160)
  kind             PresentationKind
  category         String                  @db.VarChar(40)
  name             String                  @db.VarChar(120)
  nameSortKey      String                  @db.VarChar(240)
  parentName       String?                 @db.VarChar(120)
  canonicalUrl     String?                 @db.VarChar(2048)
  descriptionEn    String                  @db.VarChar(400)
  tags             String[]                @default([])
  searchText       String                  @db.Text
  firstMentionedAt DateTime
  lastMentionedAt  DateTime
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  presentations    PresentationCandidate[]
  identityAliases  CatalogIdentityAlias[]

  @@index([lastMentionedAt, id])
  @@index([nameSortKey, id])
  @@index([kind])
  @@index([category])
}

model CatalogIdentityAlias {
  identityKey   String      @id @db.VarChar(69)
  catalogItemId String      @db.Uuid
  createdAt     DateTime    @default(now())
  catalogItem   CatalogItem @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)

  @@index([catalogItemId])
}

model AnalyzedPost {
  id                String                  @id @default(uuid()) @db.Uuid
  channelId         String                  @db.Uuid
  telegramMessageId BigInt
  sourceUrl         String                  @db.VarChar(2048)
  publishedAt       DateTime
  editedAt          DateTime?
  contentHash       String                  @db.Char(64)
  status            AnalyzedPostStatus
  promptVersion     String                  @db.VarChar(80)
  schemaVersion     String                  @db.VarChar(80)
  analysisVersion   String                  @db.VarChar(255)
  modelId           String                  @db.VarChar(120)
  attemptCount      Int                     @default(0)
  analyzedAt        DateTime                @default(now())
  errorClass        String?                 @db.VarChar(80)
  inputTokens       Int?
  outputTokens      Int?
  totalTokens       Int?
  openAiRequestId   String?                 @db.VarChar(160)
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  channel           Channel                 @relation(fields: [channelId], references: [id], onDelete: Cascade)
  presentations     PresentationCandidate[]

  @@unique([channelId, telegramMessageId])
  @@index([channelId, status])
  @@index([analysisVersion])
}

model PresentationCandidate {
  id             String           @id @default(uuid()) @db.Uuid
  analyzedPostId String           @db.Uuid
  ordinal        Int
  kind           PresentationKind
  category       String           @default("Other") @db.VarChar(40)
  name           String           @db.VarChar(120)
  parentName     String?          @db.VarChar(120)
  subjectUrl     String?          @db.VarChar(2048)
  descriptionEn  String           @db.VarChar(400)
  tags           String[]
  sourceLanguage String           @db.VarChar(16)
  confidence     Decimal          @db.Decimal(4, 3)
  catalogItemId  String?          @db.Uuid
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  analyzedPost   AnalyzedPost     @relation(fields: [analyzedPostId], references: [id], onDelete: Cascade)
  catalogItem    CatalogItem?     @relation(fields: [catalogItemId], references: [id], onDelete: SetNull)

  @@unique([analyzedPostId, ordinal])
  @@index([kind])
  @@index([category])
  @@index([catalogItemId])
}

model IngestionRun {
  id                     String             @id @default(uuid()) @db.Uuid
  startedAt              DateTime           @default(now())
  finishedAt             DateTime?
  status                 IngestionRunStatus @default(RUNNING)
  configuredChannelCount Int
  fetchedCount           Int                @default(0)
  analyzedCount          Int                @default(0)
  relevantCount          Int                @default(0)
  presentationsSaved     Int                @default(0)
  skippedCount           Int                @default(0)
  failedCount            Int                @default(0)
  channelOutcomes        Json               @default("{}")
  failureClass           String?            @db.VarChar(80)
  failureSummary         String?            @db.VarChar(240)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  @@index([startedAt])
  @@index([status])
}
