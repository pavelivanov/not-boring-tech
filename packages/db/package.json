{
  "name": "@techdex/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --clean --sourcemap",
    "lint": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "db:validate": "prisma validate",
    "generate": "prisma generate",
    "migrate:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.6.0",
    "@prisma/client": "^7.6.0",
    "dotenv": "^17",
    "pg": "^8",
    "prisma": "^7.6.0"
  },
  "devDependencies": {
    "@techdex/typescript-config": "*",
    "@types/node": "^22",
    "@types/pg": "^8",
    "prettier": "^3.8.3",
    "tsup": "^8",
    "typescript": "^6"
  }
}
