{
  "name": "findthatproject",
  "version": "0.0.0",
  "private": true,
  "packageManager": "npm@11.9.0",
  "engines": {
    "node": ">=22.22.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "deploy:railway": "bash scripts/railway-deploy.sh",
    "railway:env": "bash scripts/railway-env-push.sh"
  },
  "devDependencies": {
    "turbo": "^2.10.7"
  }
}
