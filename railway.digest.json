{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "apps/service/Dockerfile"
  },
  "deploy": {
    "startCommand": "node apps/service/dist/digest.js publish",
    "cronSchedule": "0 9 * * 1",
    "restartPolicyType": "NEVER"
  }
}
