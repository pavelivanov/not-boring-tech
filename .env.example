# PostgreSQL shared by the service and migration command.
POSTGRES_USER=findthatproject
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_DB=findthatproject
POSTGRES_PORT=5432
POSTGRES_TEST_PORT=5433
DATABASE_URL=postgresql://findthatproject:replace-with-a-local-password@127.0.0.1:5432/findthatproject

# Safe Hono defaults.
HOST=0.0.0.0
PORT=3001
SERVICE_PORT=3001
LOG_LEVEL=info
API_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Public browser configuration. This is an API origin, never a credential.
VITE_API_BASE_URL=http://localhost:3001
VITE_PUBLIC_SITE_ORIGIN=http://localhost:3000
# Public digest channels linked from the site header. Leave empty to hide the links.
VITE_DIGEST_CHANNEL_RU=
VITE_DIGEST_CHANNEL_EN=

# Sync-only server credentials. Never prefix these with VITE_ or commit real values.
TELEGRAM_API_ID=replace-with-telegram-api-id
TELEGRAM_API_HASH=replace-with-telegram-api-hash
TELEGRAM_SESSION=replace-with-pre-authorized-string-session
TELEGRAM_CHANNELS=@notboring_tech,@ctodaily
TELEGRAM_BACKFILL_DAYS=90
TELEGRAM_PAGE_SIZE=50
OPENAI_API_KEY=replace-with-openai-api-key
OPENAI_MODEL=replace-with-a-structured-outputs-compatible-model
OPENAI_REQUEST_TIMEOUT_MS=30000
OPENAI_MAX_ATTEMPTS=3

# Optional. Authentication raises GitHub's API limit; never expose this to Vite.
GITHUB_TOKEN=

# Digest-only Telegram Bot API boundary. Never reuse the GramJS user session.
# Keep both output channels out of TELEGRAM_CHANNELS to prevent a feedback loop.
TELEGRAM_DIGEST_BOT_TOKEN=replace-with-dedicated-bot-token
TELEGRAM_DIGEST_CHANNEL_EN=@replace_with_english_channel
TELEGRAM_DIGEST_CHANNEL_RU=@replace_with_russian_channel
DIGEST_SITE_ORIGIN=https://findthatproject.example
DIGEST_INITIAL_START_AT=replace-with-last-completed-parser-run-utc
DIGEST_REQUEST_TIMEOUT_MS=15000
DIGEST_MAX_ATTEMPTS=3
