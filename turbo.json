{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": [".env.example", "packages/*-config/*.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**", "generated/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {},
    "test": {
      "cache": false,
      "passThroughEnv": ["TEST_DATABASE_URL"]
    }
  }
}
